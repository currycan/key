proxies:
  - name: ${REGION_INFO}|${NODE_NAME}|hysteria2
    type: hysteria2
    server: ${NODE_IP}
    port: ${PORT_HYSTERIA2}
    up: 2500 Mbps
    down: 2500 Mbps
    password: ${SB_UUID}
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|tuic
    type: tuic
    server: ${NODE_IP}
    port: ${PORT_TUIC}
    uuid: ${SB_UUID}
    password: ${SB_UUID}
    alpn:
      - h3
    disable-sni: true
    reduce-rtt: true
    request-timeout: 8000
    udp-relay-mode: native
    congestion-controller: bbr
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|ShadowTLS
    type: ss
    server: ${NODE_IP}
    port: ${PORT_SHADOWTLS}
    cipher: ${SS_METHOD}
    password: ${RANDOM_PASSWORD}
    plugin: shadow-tls
    client-fingerprint: chrome
    plugin-opts:
      host: ${SINGBOX_SERVER_NAME}
      password: ${SB_UUID}
      version: 3
    smux:
      enabled: true
      protocol: h2mux
      padding: true
      max-connections: 8
      min-streams: 16
      statistic: true
      only-tcp: false
    brutal-opts:
      enabled: ${IS_BRUTAL}
      up: 2500 Mbps
      down: 2500 Mbps

  - name: ${REGION_INFO}|${NODE_NAME}|shadowsocks
    type: ss
    server: ${NODE_IP}
    port: ${PORT_SHADOWSOCKS}
    cipher: ${SS_METHOD}
    password: ${RANDOM_PASSWORD}
    smux:
      enabled: true
      protocol: h2mux
      padding: true
      max-connections: 8
      min-streams: 16
      statistic: true
      only-tcp: false
    brutal-opts:
      enabled: ${IS_BRUTAL}
      up: 2500 Mbps
      down: 2500 Mbps

  - name: ${REGION_INFO}|${NODE_NAME}|anytls
    type: anytls
    server: ${NODE_IP}
    port: ${PORT_ANYTLS}
    password: ${SB_UUID}
    client-fingerprint: chrome
    udp: true
    idle-session-check-interval: 30
    idle-session-timeout: 30
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|trojan-ws-tls
    type: trojan
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    password: ${XRAY_UUID}
    tls: true
    servername: common.${DOMAIN}
    network: ws
    skip-cert-verify: false
    ws-opts:
      path: /${XRAY_URL_PATH}-trojan
      headers:
        Host: common.${DOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|vless-ws-tls
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    servername: common.${DOMAIN}
    network: ws
    skip-cert-verify: false
    ws-opts:
      path: /${XRAY_URL_PATH}-vless
      headers:
        Host: common.${DOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|vmess-ws-tls
    type: vmess
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    servername: common.${DOMAIN}
    alterId: 0
    cipher: auto
    skip-cert-verify: false
    network: ws
    ws-opts:
      path: /${XRAY_URL_PATH}-vmess
      headers:
        Host: common.${DOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|XTLS(Vision)+Reality直连
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    flow: xtls-rprx-vision
    client-fingerprint: chrome
    skip-cert-verify: false
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
      _spider-x: /
    network: tcp
    servername: ${DOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|Xhttp+Reality直连
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    client-fingerprint: chrome
    skip-cert-verify: false
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
    network: xhttp
    xhttp-opts:
      path: /${XRAY_URL_PATH}
    servername: ${DOMAIN}
    encryption: none

  - name: ${REGION_INFO}|${NODE_NAME}|上行Xhttp+TLS+CDN|下行Xhttp+Reality
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: xhttp
    xhttp-opts:
      headers:
        Host: ${CDNDOMAIN}
      path: /${XRAY_URL_PATH}
    servername: ${CDNDOMAIN}
    encryption: mlkem768x25519plus.native.0rtt.${XRAY_MLKEM768_CLIENT}

  - name: ${REGION_INFO}|${NODE_NAME}|上行Xhttp+Reality|下行Xhttp+TLS+CDN
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
    network: xhttp
    xhttp-opts:
      path: /${XRAY_URL_PATH}
    servername: ${DOMAIN}
    encryption: mlkem768x25519plus.native.0rtt.${XRAY_MLKEM768_CLIENT}

  - name: ${REGION_INFO}|${NODE_NAME}|Xhttp+TLS+CDN上下行不分离
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: xhttp
    xhttp-opts:
      headers:
        Host: ${CDNDOMAIN}
      path: /${XRAY_URL_PATH}
    servername: ${CDNDOMAIN}
    encryption: mlkem768x25519plus.native.0rtt.${XRAY_MLKEM768_CLIENT}
