proxies:
  - name: ${REGION_INFO}|${NODE_NAME}|hysteria2
    type: hysteria2
    server: ${NODE_IP}
    port: ${PORT_HYSTERIA2}
    alpn:
      - h3
    up: 2500 Mbps
    down: 2500 Mbps
    password: ${SB_UUID}
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|tuic
    type: tuic
    server: ${NODE_IP}
    port: ${PORT_TUIC}
    uuid: ${SB_UUID}
    password: ${SB_UUID}
    alpn:
      - h3
    disable-sni: true
    reduce-rtt: true
    request-timeout: 8000
    udp-relay-mode: native
    congestion-controller: bbr
    skip-cert-verify: true
    version: 5

  - name: ${REGION_INFO}|${NODE_NAME}|anytls
    type: anytls
    server: ${NODE_IP}
    port: ${PORT_ANYTLS}
    password: ${SB_UUID}
    client-fingerprint: chrome
    udp: true
    idle-session-check-interval: 30
    idle-session-timeout: 30
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|VMess-TLS-WS
    type: vmess
    server: ${CDNDOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    alterId: 0
    cipher: auto
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: ws
    ws-opts:
      headers:
        Host: ${CDNDOMAIN}
      path: /${XRAY_URL_PATH}-vmessws
    servername: ${CDNDOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|XTLS(Vision)+Reality直连
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    flow: xtls-rprx-vision
    client-fingerprint: chrome
    skip-cert-verify: false
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
      _spider-x: /
    network: tcp
    servername: ${DOMAIN}
