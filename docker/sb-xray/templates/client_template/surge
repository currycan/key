# Hysteria2
${REGION_INFO}|${NODE_NAME}|hysteria2=hysteria2,${DOMAIN},${PORT_HYSTERIA2},password="${SB_UUID}",skip-cert-verify=true,download-bandwidth=2500
# TUICv5
${REGION_INFO}|${NODE_NAME}|tuic=tuic-v5,${DOMAIN},${PORT_TUIC},uuid=${SB_UUID},password="${SB_UUID}",alpn=h3,sni=off,skip-cert-verify=true
# ShadowTLS+Shadowsocks2022
${REGION_INFO}|${NODE_NAME}|ShadowTLS=ss,${DOMAIN},${PORT_SHADOWTLS},encrypt-method=${SS_METHOD},password="${RANDOM_PASSWORD}",shadow-tls-password=${SB_UUID},shadow-tls-sni=${SINGBOX_SERVER_NAME},shadow-tls-version=3
# 普通ShadowsocksAEAD
${REGION_INFO}|${NODE_NAME}|shadowsocks=ss,${DOMAIN},${PORT_SHADOWSOCKS},encrypt-method=${SS_METHOD},password="${RANDOM_PASSWORD}"
# Trojan WS+TLS
${REGION_INFO}|${NODE_NAME}|trojan-ws-tls=trojan,${DOMAIN},${LISTENING_PORT},password="${XRAY_UUID}",tls=true,ws=true,ws-path=/${XRAY_UUID}-trojan,ws-headers=Host:"common.${DOMAIN}",sni=${DOMAIN},skip-cert-verify=true
# VMess WS+TLS
${REGION_INFO}|${NODE_NAME}|vmess-ws-tls=vmess,${DOMAIN},${LISTENING_PORT},username=${XRAY_UUID},ws=true,ws-path=/${XRAY_UUID}-vmess,ws-headers=Host:"common.${DOMAIN}",vmess-aead=true,tls=true,sni=common.${DOMAIN},skip-cert-verify=true,udp-relay=true
