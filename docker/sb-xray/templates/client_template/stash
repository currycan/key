proxies:
- name: ${REGION_INFO}|${NODE_NAME}|hysteria2
  type: hysteria2
  server: ${NODE_IP}
  port: ${PORT_HYSTERIA2}
  password: ${SB_UUID}
  skip-cert-verify: true

- name: ${REGION_INFO}|${NODE_NAME}|ShadowTLS
  type: ss
  server: ${NODE_IP}
  port: ${PORT_SHADOWTLS}
  cipher: ${SS_METHOD}
  password: ${RANDOM_PASSWORD}
  plugin: shadow-tls
  client-fingerprint: chrome
  plugin-opts:
    host: ${SINGBOX_SERVER_NAME}
    password: ${SB_UUID}
    version: 3

- name: ${REGION_INFO}|${NODE_NAME}|shadowsocks
  type: ss
  server: ${NODE_IP}
  port: ${PORT_SHADOWSOCKS}
  cipher: ${SS_METHOD}
  password: ${RANDOM_PASSWORD}

- name: ${REGION_INFO}|${NODE_NAME}|trojan-ws-tls
  type: trojan
  server: ${DOMAIN}
  port: ${LISTENING_PORT}
  password: ${XRAY_UUID}
  tls: true
  servername: common.${DOMAIN}
  network: ws
  skip-cert-verify: false
  ws-opts:
    path: /${XRAY_URL_PATH}-trojan
    headers:
      Host: common.${DOMAIN}

- name: ${REGION_INFO}|${NODE_NAME}|vless-ws-tls
  type: vless
  server: ${DOMAIN}
  port: ${LISTENING_PORT}
  uuid: ${XRAY_UUID}
  tls: true
  servername: common.${DOMAIN}
  network: ws
  skip-cert-verify: false
  ws-opts:
    path: /${XRAY_URL_PATH}-vless
    headers:
      Host: common.${DOMAIN}

- name: ${REGION_INFO}|${NODE_NAME}|vmess-ws-tls
  type: vmess
  server: ${DOMAIN}
  port: ${LISTENING_PORT}
  uuid: ${XRAY_UUID}
  tls: true
  servername: common.${DOMAIN}
  alterId: 0
  cipher: auto
  skip-cert-verify: false
  network: ws
  ws-opts:
    path: /${XRAY_URL_PATH}-vmess
    headers:
      Host: common.${DOMAIN}

- name: ${REGION_INFO}|${NODE_NAME}|XTLS(Vision)+Reality直连
  type: vless
  server: ${DOMAIN}
  port: ${LISTENING_PORT}
  uuid: ${XRAY_UUID}
  tls: true
  flow: xtls-rprx-vision
  client-fingerprint: chrome
  skip-cert-verify: false
  reality-opts:
    public-key: ${XRAY_REALITY_PUBLIC_KEY}
    short-id: ${XRAY_REALITY_SHORTID}
    _spider-x: /
  network: tcp
  servername: ${DOMAIN}
