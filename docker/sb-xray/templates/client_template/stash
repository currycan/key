proxies:
  - name: ${REGION_INFO}|${NODE_NAME}|hysteria2
    type: hysteria2
    server: ${DOMAIN}
    port: ${PORT_HYSTERIA2}
    password: ${SB_UUID}
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|tuic
    type: tuic
    server: ${DOMAIN}
    port: ${PORT_TUIC}
    uuid: ${SB_UUID}
    sni: ''
    password: ${SB_UUID}
    alpn:
      - h3
    skip-cert-verify: true
    version: 5

  - name: ${REGION_INFO}|${NODE_NAME}|VMess-TLS-WS
    type: vmess
    server: ${CDNDOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    alterId: 0
    cipher: auto
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: ws
    ws-opts:
      headers:
        Host: ${CDNDOMAIN}
      path: /${XRAY_URL_PATH}-vmessws
    servername: ${CDNDOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|XTLS(Vision)+Reality直连
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    flow: xtls-rprx-vision
    client-fingerprint: chrome
    skip-cert-verify: false
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
      _spider-x: /
    network: tcp
    servername: ${DOMAIN}
