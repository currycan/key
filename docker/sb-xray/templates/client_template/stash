proxies:
  - name: ${REGION_INFO}|${NODE_NAME}|hysteria2
    type: hysteria2
    server: ${NODE_IP}
    port: ${PORT_HYSTERIA2}
    password: ${SB_UUID}
    skip-cert-verify: true

  - name: ${REGION_INFO}|${NODE_NAME}|tuic
    type: tuic
    server: ${NODE_IP}
    port: ${PORT_TUIC}
    uuid: ${SB_UUID}
    sni: ''
    password: ${SB_UUID}
    alpn:
      - h3
    skip-cert-verify: true
    version: 5

  - name: ${REGION_INFO}|${NODE_NAME}|ShadowTLS
    type: ss
    server: ${NODE_IP}
    port: ${PORT_SHADOWTLS}
    cipher: ${SS_METHOD}
    password: ${RANDOM_PASSWORD}
    plugin: shadow-tls
    client-fingerprint: chrome
    plugin-opts:
      host: ${DOMAIN}
      password: ${SB_UUID}
      version: 3

  - name: ${REGION_INFO}|${NODE_NAME}|VLESS-TLS-gRPC
    type: vless
    server: ${CDNDOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: grpc
    grpc-opts:
      grpc-service-name: ${XRAY_URL_PATH}-vless
    servername: ${CDNDOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|VMess-TLS-gRPC
    type: vmess
    server: ${CDNDOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    alterId: 0
    cipher: auto
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: grpc
    grpc-opts:
      grpc-service-name: ${XRAY_URL_PATH}-vmess
    servername: ${CDNDOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|Trojan-TLS-gRPC
    type: trojan
    server: ${CDNDOMAIN}
    port: ${LISTENING_PORT}
    password: ${XRAY_UUID}
    tls: true
    client-fingerprint: chrome
    alpn:
      - h2
    skip-cert-verify: false
    network: grpc
    grpc-opts:
      grpc-service-name: ${XRAY_URL_PATH}-trojan
    servername: reality.${DOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|Trojan-REALITY-gRPC
    type: trojan
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    password: ${XRAY_UUID}
    tls: true
    network: grpc
    alpn:
      - h2
    skip-cert-verify: false
    grpc-opts:
      grpc-service-name: ${XRAY_URL_PATH}-trojan
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
    servername: reality.${DOMAIN}

  - name: ${REGION_INFO}|${NODE_NAME}|XTLS(Vision)+Reality直连
    type: vless
    server: ${DOMAIN}
    port: ${LISTENING_PORT}
    uuid: ${XRAY_UUID}
    tls: true
    flow: xtls-rprx-vision
    client-fingerprint: chrome
    skip-cert-verify: false
    reality-opts:
      public-key: ${XRAY_REALITY_PUBLIC_KEY}
      short-id: ${XRAY_REALITY_SHORTID}
      _spider-x: /
    network: tcp
    servername: reality.${DOMAIN}
