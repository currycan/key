{
    "inbounds": [
        {
            "listen": "/dev/shm/vless.sock,0666",
            "protocol": "vless",
            "tag": "VLESS-TLS",
            "settings": {
                "clients": [
                    {
                        "id": "${XRAY_UUID}",
                        "email": "vless@tls"
                    }
                ],
                "decryption": "none"
            },
            "streamSettings": {
                "network": "ws",
                "wsSettings": {
                    "path": "/${XRAY_URL_PATH}-vless",
                    "headers": {
                        "Host": "common.${DOMAIN}"
                    }
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            }
        }
    ]
}
