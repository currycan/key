{
    "log": {
        "access": "${LOGDIR}/xray/access.log",
        "error": "${LOGDIR}/xray/error.log",
        "loglevel": "warning"
    },
    "dns": {
        "servers": [
            "https+local://cloudflare-dns.com/dns-query",
            "1.1.1.1",
            "1.0.0.1",
            "8.8.8.8",
            "8.8.4.4",
            "localhost"
        ]
    },
    "api": {
        "tag": "api",
        "services": [
            "HandlerService",
            "LoggerService",
            "StatsService"
        ]
    },
    "stats": {},
    "policy": {
        "levels": {
            "0": {
                "handshake": 8,
                "connIdle": 797,
                "uplinkOnly": 8,
                "downlinkOnly": 11,
                "statsUserUplink": true,
                "statsUserDownlink": true
            }
        },
        "system": {
            "statsInboundUplink": true,
            "statsInboundDownlink": true,
            "statsOutboundUplink": true,
            "statsOutboundDownlink": true
        }
    },
    "routing": {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {
                "type": "field",
                "ruleTag": "api",
                "inboundTag": [
                    "api"
                ],
                "outboundTag": "api"
            },
            {
                "type": "field",
                "ruleTag": "bt",
                "protocol": [
                    "bittorrent"
                ],
                "marktag": "ban_bt",
                "outboundTag": "block"
            },
            {
                "type": "field",
                "ruleTag": "cn-ip",
                "ip": [
                    "geoip:cn"
                ],
                "marktag": "ban_geoip_cn",
                "outboundTag": "block"
            },
            {
                "type": "field",
                "ruleTag": "ad-domain",
                "domain": [
                    "geosite:category-ads-all"
                ],
                "outboundTag": "block"
            },
            {
                "type": "field",
                "domain": [
                    "geosite:openai"
                ],
                "marktag": "fix_openai",
                "outboundTag": "direct"
            },
            {
                "type": "field",
                "ruleTag": "private-ip",
                "ip": [
                    "geoip:private"
                ],
                "outboundTag": "block"
            }
        ]
    },
    "inbounds": [
        {
            "tag": "api",
            "port": 7978,
            "listen": "127.0.0.1",
            "protocol": "dokodemo-door",
            "settings": {
                "address": "127.0.0.1"
            }
        }
    ],
    "outbounds": [
        {
            "tag": "direct",
            "protocol": "freedom"
        },
        {
            "tag": "block",
            "protocol": "blackhole"
        },
        {
            "tag": "hysteria-out",
            "protocol": "hysteria",
            "settings": {
                "version": 2,
                "address": "${DOMAIN}",
                "port": 1081
            },
            "streamSettings": {
                "network": "hysteria",
                "hysteriaSettings": {
                    "version": 2,
                    "auth": "${PASSWORD}",
                    "congestion": "bbr",
                    "up": "2500mbps",
                    "down": "2500mbps",
                    "udphop": {
                        "port": "20000-50000",
                        "interval": 30
                    }
                },
                "security": "tls",
                "tlsSettings": {
                    "serverName": "${DOMAIN}",
                    "allowInsecure": true,
                    "alpn": [
                        "h3"
                    ]
                },
                "udpmasks": [
                    {
                        "type": "salamander",
                        "settings": {
                            "password": "${PUBLIC_PASSWORD}"
                        }
                    }
                ]
            }
        }
    ]
}
