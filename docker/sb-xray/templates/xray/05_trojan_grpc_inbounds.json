{
    "inbounds": [
        {
            "listen": "/dev/shm/udstrojangrpc.sock,0666",
            "protocol": "trojan",
            "tag": "TROJAN_WS_IN",
            "settings": {
                "clients": [
                    {
                        "password": "${XRAY_UUID}",
                        "level": 0,
                        "email": "trojan@ws"
                    }
                ]
            },
            "streamSettings": {
                "network": "grpc",
                "grpcSettings": {
                    "serviceName": "${XRAY_URL_PATH}-trojan"
                },
                "sockopt": {
                    "tcpFastOpen": true,
                    "acceptProxyProtocol": false,
                    "tcpcongestion": "bbr",
                    "tcpMptcp": true,
                    "tcpNoDelay": true
                }
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ],
                "metadataOnly": false,
                "routeOnly": true
            }
        }
    ]
}
