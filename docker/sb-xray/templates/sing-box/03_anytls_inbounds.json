{
    "inbounds": [
        {
            "type": "anytls",
            "tag": "sing-box anytls",
            "listen": "unix",
            "listen_path": "/dev/shm/anytls.sock",
            "proxy_protocol": true,
            "users": [
                {
                    "password": "${SB_UUID}"
                }
            ],
            "padding_scheme": [],
            "tls": {
                "enabled": true,
                "server_name": "at.${DOMAIN}",
                "certificate_path": "${SSL_PATH}/sb_xray_bundle.crt",
                "key_path": "${SSL_PATH}/sb_xray_bundle.key"
            }
        }
    ]
}
